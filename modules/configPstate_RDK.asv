function configPstate_RDK
%periodic grater

global Pstate Pdoc

Pdoc=struct;

Pdoc.general='RDK';


Pstate = struct; %clear it

Pstate.param{1}     = {'predelay'  'float'      2       0                'sec'};
Pdoc.param{1}='Predelay with dots time period';
Pstate.param{end+1} = {'predelayBlank'  'float'      0       0                'sec'};
Pdoc.param{end+1}='Predelay without dots time period';
Pstate.param{end+1} = {'postdelay'  'float'     2       0                'sec'};
Pdoc.param{end+1}='Postdelay with dots time period';
Pstate.param{end+1} = {'postdelayBlank'  'float'      0       0                'sec'};
Pdoc.param{end+1}='Postdelay without dots time period';
Pstate.param{end+1} = {'stim_time'  'float'     1       0                'sec'};
Pdoc.param{end+1}='Stimulus time period';

Pstate.param{end+1} = {'x_pos'       'int'      600       0                'pixels'};
Pdoc.param{end+1}='center x coord';
Pstate.param{end+1} = {'y_pos'       'int'      400       0                'pixels'};
Pdoc.param{end+1}='center y coord';
Pstate.param{end+1} = {'x_size'      'float'      3       1                'deg'};
Pdoc.param{end+1}='no mask: x size; mask: maximum x size';
Pstate.param{end+1} = {'y_size'      'float'      3       1                'deg'};
Pdoc.param{end+1}='no mask: y size; mask: maximum y size';
Pstate.param{end+1} = {'mask_radius' 'float'      6       1                'deg'};
Pdoc.param{end+1}='mask radius';
Pstate.param{end+1} = {'mask_type' 'string'      'disc'       0                ''};
Pdoc.param{end+1}='mask; options: none, gauss, disc';

Pstate.param{end+1} = {'background'      'float'   0.5       0                ''};
Pdoc.param{end+1}='background';

Pstate.param{end+1} = {'sizeDots'      'float'     0.2       1                'deg'};
Pdoc.param{end+1}='size dots';
Pstate.param{end+1} = {'dotType'      'int'     0       0                ''};
Pdoc.param{end+1}='dot type; options: square (0), round (1)';


Pstate.param{end+1} = {'ori'      'int'     0       0                'deg'};
Pdoc.param{end+1}='direction';
Pstate.param{end+1} = {'dotDensity'      'float'      100       1                'dots/(deg^2)'};
Pdoc.param{end+1}='dot density';
Pstate.param{end+1} = {'speedDots'      'float'     5       1                'deg/s'};
Pdoc.param{end+1}='speed';
Pstate.param{end+1} = {'dotLifetime'      'int'     0       1                'frames'};
Pdoc.param{end+1}='lifetime; 0 - indefinite';
Pstate.param{end+1} = {'dotCoherence'      'int'     100       0                '%'};
Pdoc.param{end+1}='coherence (brownian noise)';
Pstate.param{end+1} = {'noNetNoise'      'int'     0      0            ''};
Pdoc.param{end+1}='remove net noise movement';
Pstate.param{end+1} = {'motionopp_bit'    'int'     0       0                'binary'};
Pdoc.param{end+1}='2 dot stimuli on top of each other';
Pstate.param{end+1} = {'surround_bit'    'int'     0       0                'binary'};
Pdoc.param{end+1}='2nd dot stimulus in surround';

Pstate.param{end+1} = {'x_size2'      'float'      3       0                'deg'};
Pdoc.param{end+1}='no mask: x size stim 2; mask: maximum x size';
Pstate.param{end+1} = {'y_size2'      'float'      3       0                'deg'};
Pdoc.param{end+1}='no mask: y size stim 2; mask: maximum y size';
Pstate.param{end+1} = {'mask_radius2' 'float'      6      0               'deg'};
Pdoc.param{end+1}='mask radius stim 2';
Pstate.param{end+1} = {'mask_type2' 'string'      'disc'      0               ''};
Pdoc.param{end+1}='mask stim 2; options: none, gauss, disc';
Pstate.param{end+1} = {'ori2'      'int'     0       0                'deg'};
Pdoc.param{end+1}='direction stim 2';
Pstate.param{end+1} = {'dotDensity2'      'float'      100       0                'dots/(deg^2 s)'};
Pdoc.param{end+1}='dot density stim 2';
Pstate.param{end+1} = {'speedDots2'      'float'     5      0               'deg/s'};
Pdoc.param{end+1}='speed stim 2';
Pstate.param{end+1} = {'dotLifetime2'      'int'     0       0                'frames'};
Pdoc.param{end+1}='lifetime stim 2; 0 - indefinite';
Pstate.param{end+1} = {'dotCoherence2'      'int'     100       0                '%'};
Pdoc.param{end+1}='coherence stim 2';

Pstate.param{end+1} = {'redgun' 'float'   1       0             ''};
Pstate.param{end+1} = {'greengun' 'float'   1       0             ''};
Pstate.param{end+1} = {'bluegun' 'float'   1       0             ''};

Pstate.param{end+1} = {'Leye_bit'    'int'   1       0                ''};
Pstate.param{end+1} = {'Reye_bit'    'int'   1       0                ''};



